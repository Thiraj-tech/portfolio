# Copy this file to .env and fill in real values. .env is gitignored — never commit it.

# Figma API key, used by the Figma MCP tool.
FIGMA_API_KEY=

# Base URL of the contact-form mail relay (see server/contact-api). Baked in
# at build time since this is a static export — must be set before `npm run
# build` / `npm run dev` for the Contact form to actually submit anywhere.
NEXT_PUBLIC_CONTACT_API_URL=https://api.thiraj.space/contact

# Supabase project URL + anon (public) key, used by the review-collection
# system (app/lib/supabaseClient.ts, app/review, app/admin, and the
# Testimonials section's fetch of approved reviews), the projects admin, and
# the blog (app/blog, app/admin/blog — fetched at build time via
# generateStaticParams/async Server Components, so these MUST be set before
# `npm run build` for blog posts and their sitemap entries to appear). Baked
# in at build time since this is a static export. Run
# supabase/migrations/0001_reviews.sql, 0003_projects.sql, and
# 0005_posts.sql in your project's SQL editor before these do anything
# useful — see each file's header for the full setup steps.
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=thiraj.hettiarachchi@gmail.com
SMTP_PASS=<the 16-character app password, no spaces>
MAIL_TO=thiraj.hettiarachchi@gmail.com

