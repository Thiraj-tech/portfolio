# Copy this file to .env and fill in real values. .env is gitignored — never commit it.

# Figma API key, used by the Figma MCP tool.
FIGMA_API_KEY=

# Base URL of the contact-form mail relay (see server/contact-api). Baked in
# at build time since this is a static export — must be set before `npm run
# build` / `npm run dev` for the Contact form to actually submit anywhere.
NEXT_PUBLIC_CONTACT_API_URL=https://api.thiraj.space/contact

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=thiraj.hettiarachchi@gmail.com
SMTP_PASS=<the 16-character app password, no spaces>
MAIL_TO=thiraj.hettiarachchi@gmail.com

