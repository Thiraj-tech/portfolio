# Copy this file to .env and fill in real values. .env is gitignored — never commit it.

# SMTP credentials for the mailbox created in InterServer's Mail panel.
SMTP_HOST=mail.thiraj.space
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=contact@thiraj.space
SMTP_PASS=

# Where contact form submissions get delivered. Defaults to SMTP_USER if unset.
MAIL_TO=thiraj.hettiarachchi@gmail.com

# Comma-separated list of origins allowed to POST to this API.
ALLOWED_ORIGINS=https://thiraj.space,https://www.thiraj.space,http://localhost:3000

PORT=3001
